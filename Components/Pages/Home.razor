@page "/"
@rendermode InteractiveServer


@using LoginAgain.Components.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db

<PageTitle>Login</PageTitle>

<div class="LoginCard">
    <h1>Break Me!</h1>

    <h3>@ErrorMsg</h3>

    <input @bind="inputUsername" placeholder="Enter Your Username..." />
    <input @bind="inputPassword"  placeholder="Enter Your Password..." />

    <button Color="Blue" @onclick="Login">
        Login
    </button>
</div>

@code {
    private string inputUsername = "";
    private string inputPassword = "";

    private string ErrorMsg = "";

    private async Task Login()
    {
        var user = await Db.Users
            .FirstOrDefaultAsync(x =>
                x.username == inputUsername &&
                x.password == inputPassword);

        if (user != null)
        {
            ErrorMsg = "Login successful!";
        }
        else
        {
            ErrorMsg = "Invalid username or password.";
        }
    }
}
